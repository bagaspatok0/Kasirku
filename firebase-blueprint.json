{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for sale.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number", "description": "Current stock quantity" },
        "trackInventory": { "type": "boolean", "description": "Whether to track stock for this product" },
        "category": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "quantity", "category"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A completed sale transaction.",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "transfer", "qris"] },
        "cashReceived": { "type": "number" },
        "change": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "void", "pending"] },
        "isSettled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["items", "totalAmount", "paymentMethod", "createdAt", "userId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category.",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "CashMovement": {
      "title": "Cash Movement",
      "description": "Record of cash in or cash out.",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "description": { "type": "string" },
        "isSettled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["amount", "type", "description", "createdAt", "userId"]
    },
    "Settlement": {
      "title": "Settlement",
      "description": "Daily reconciliation report.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "totalTransactions": { "type": "number" },
        "totalSales": { "type": "number" },
        "totalCashSales": { "type": "number" },
        "totalNonCashSales": { "type": "number" },
        "totalCashIn": { "type": "number" },
        "totalCashOut": { "type": "number" },
        "expectedCash": { "type": "number" },
        "actualCash": { "type": "number" },
        "difference": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["date", "totalTransactions", "totalSales", "totalCashSales", "totalNonCashSales", "totalCashIn", "totalCashOut", "expectedCash", "actualCash", "difference", "createdAt", "userId"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global product list"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Sales history"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Available product categories"
    },
    "/cash_movements/{movementId}": {
      "schema": "CashMovement",
      "description": "Daily cash flow tracking"
    },
    "/settlements/{settlementId}": {
      "schema": "Settlement",
      "description": "End of shift reports"
    }
  }
}
